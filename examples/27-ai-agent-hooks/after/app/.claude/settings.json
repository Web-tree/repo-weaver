{
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": ["Bash(git status)", "Read(**)"],
    "deny": ["Bash(rm -rf *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/redact-secrets.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'repo-weaver-managed repo — see AGENTS.md'"
          }
        ]
      }
    ]
  }
}
