version: "3.8"

services:
  app:
    image: {{ image_name }}:latest
    ports:
{% for port in ports %}
      - "{{ port }}:{{ port }}"
{% endfor %}
{% if enable_db %}
  database:
    image: postgres:16
    environment:
      POSTGRES_DB: {{ db_name }}
      POSTGRES_USER: admin
    ports:
      - "5432:5432"
{% endif %}
